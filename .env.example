# ─────────────────────────────────────────────────────────────────────────────
# CodeAtlas AI — Environment Variables Reference
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-32-char-random-string!!
JWT_SECRET=change-me
APP_URL=http://localhost

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=codeatlas
DB_USER=codeatlas
DB_PASSWORD=password

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Object Storage (MinIO / S3) ───────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
# Bucket names (created automatically on startup)
MINIO_BUCKET_REPOS=codeatlas-repos
MINIO_BUCKET_DIAGRAMS=codeatlas-diagrams

# ── Vector Store (Qdrant) ─────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ── Graph Database (Neo4j) ────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Options: ollama | openai | anthropic
LLM_PROVIDER=ollama

# Ollama (local — default)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# OpenAI (cloud)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic (cloud)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ── Diagram Renderer (Kroki) ──────────────────────────────────────────────────
KROKI_URL=http://localhost:8009

# ── Observability ─────────────────────────────────────────────────────────────
# Logging: json | console
LOG_FORMAT=console

# OpenTelemetry tracing
OTEL_ENABLED=false
OTEL_SERVICE_NAME=codeatlas-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=admin

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ── Celery ────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
